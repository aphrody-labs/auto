{
  "name": "@aphrody/auto",
  "version": "2026.11.5",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./packages/client/src/index.ts",
    "./domain": "./packages/domain/src/index.ts",
    "./i18n": "./packages/i18n/src/index.ts",
    "./native": "./packages/native/src/index.ts",
    "./platform": "./packages/platform/src/index.ts",
    "./store": "./packages/store/src/index.ts",
    "./services": "./packages/services/src/index.ts",
    "./server": "./apps/server/src/index.ts"
  },
  "scripts": {
    "dev": "bun --watch apps/server/src/bin.ts",
    "server": "bun apps/server/src/bin.ts",
    "migrate": "bun packages/store/src/migrate.ts",
    "openapi": "bun scripts/openapi.ts",
    "test": "bun test --timeout 30000",
    "check": "bun check",
    "lint": "bun lint apps packages scripts src",
    "fmt": "bun fmt apps packages scripts docs src",
    "build:native": "bun scripts/build-native.ts",
    "build:aot": "bun scripts/build-aot.ts",
    "build:rust": "bun scripts/cargo.ts build --release --workspace",
    "validate:facturx": "bun scripts/validate-facturx.ts",
    "gates": "bun run build:native && bun check && bun lint apps packages scripts src && bun fmt --check apps packages scripts docs src && bun test --timeout 30000",
    "gates:rust": "bun scripts/cargo.ts fmt -- --check && bun scripts/cargo.ts clippy --workspace --all-targets -- -D warnings && bun scripts/cargo.ts test --workspace"
  },
  "dependencies": {
    "@aphrody/auto-client": "workspace:*",
    "@aphrody/auto-domain": "workspace:*",
    "@aphrody/auto-i18n": "workspace:*",
    "@aphrody/auto-native": "workspace:*",
    "@aphrody/auto-platform": "workspace:*",
    "@aphrody/auto-server": "workspace:*",
    "@aphrody/auto-services": "workspace:*",
    "@aphrody/auto-store": "workspace:*",
    "@aphrody/bun-plugin-tailwind": "1.4.7"
  },
  "devDependencies": {
    "@aphrody/bun-types": "1.4.7"
  }
}
