{
  "id": "autoEvenements01",
  "name": "auto : événements métier",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "connections": {
    "Événement auto": { "main": [[{ "node": "Vérifier la signature", "type": "main", "index": 0 }]] },
    "Vérifier la signature": {
      "main": [
        [
          { "node": "Facture émise ?", "type": "main", "index": 0 },
          { "node": "Relance ?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Relance ?": { "main": [[{ "node": "Transmettre aux relances", "type": "main", "index": 0 }], []] },
    "Facture émise ?": { "main": [[{ "node": "Télécharger le Factur-X", "type": "main", "index": 0 }], []] },
    "Télécharger le Factur-X": { "main": [[{ "node": "Archiver", "type": "main", "index": 0 }]] }
  },
  "nodes": [
    {
      "id": "8f0c2a0e-1b4e-4c55-9d3f-0a1b2c3d4e01",
      "name": "Événement auto",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "4b6f7a52-2d55-4f3e-8a77-auto0evenements",
      "parameters": { "httpMethod": "POST", "path": "auto-evenements", "responseMode": "onReceived", "options": {} }
    },
    {
      "id": "8f0c2a0e-1b4e-4c55-9d3f-0a1b2c3d4e02",
      "name": "Vérifier la signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0],
      "parameters": {
        "jsCode": "// Le corps est le JSON.stringify de l'événement : le re-sérialiser redonne les octets signés.\nconst crypto = require('crypto');\nconst secret = $env.N8N_WEBHOOK_SECRET;\nreturn $input.all().map((item) => {\n  const corps = JSON.stringify(item.json.body);\n  const attendu = 'sha256=' + crypto.createHmac('sha256', secret).update(corps).digest('hex');\n  const recu = String(item.json.headers['x-auto-signature'] ?? '');\n  if (recu.length !== attendu.length || !crypto.timingSafeEqual(Buffer.from(recu), Buffer.from(attendu))) {\n    throw new Error('signature invalide');\n  }\n  return { json: item.json.body };\n});"
      }
    },
    {
      "id": "8f0c2a0e-1b4e-4c55-9d3f-0a1b2c3d4e03",
      "name": "Facture émise ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.type }}",
              "rightValue": "document.emis",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.data.type }}",
              "rightValue": "facture",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "8f0c2a0e-1b4e-4c55-9d3f-0a1b2c3d4e04",
      "name": "Télécharger le Factur-X",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, -80],
      "credentials": { "httpHeaderAuth": { "id": "autoApi000000001", "name": "API auto" } },
      "parameters": {
        "url": "={{ $env.AUTO_API_URL }}/v1/documents/{{ $json.data.id }}/pdf",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "response": { "response": { "responseFormat": "file" } } }
      }
    },
    {
      "id": "8f0c2a0e-1b4e-4c55-9d3f-0a1b2c3d4e05",
      "name": "Archiver",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [960, -80],
      "parameters": {
        "operation": "write",
        "fileName": "=/archives/{{ $('Facture émise ?').item.json.tenantId }}_{{ $('Facture émise ?').item.json.data.numero }}.pdf",
        "options": {}
      }
    },
    {
      "id": "8f0c2a0e-1b4e-4c55-9d3f-0a1b2c3d4e06",
      "name": "Relance ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "r1",
              "leftValue": "={{ $json.type }}",
              "rightValue": "relance.a_envoyer",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "8f0c2a0e-1b4e-4c55-9d3f-0a1b2c3d4e07",
      "name": "Transmettre aux relances",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 200],
      "notes": "Corps et signature d'origine : auto-relances revérifie la signature.",
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/auto-relances",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-auto-signature", "value": "={{ $('Événement auto').item.json.headers['x-auto-signature'] }}" },
            { "name": "x-auto-evenement", "value": "={{ $json.id }}" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    }
  ]
}
